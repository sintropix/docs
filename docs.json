{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Sintropix",
  "theme": "luma",
  "colors": {
    "primary": "#3a48b0",
    "light": "#869efc",
    "dark": "#5669c2"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://sintropix.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "api-reference/overview",
              "guides/api-keys",
              "quickstart",
              "core-concepts"
            ]
          },
          {
            "group": "Ledger",
            "pages": [
              "api-reference/entities",
              "api-reference/chart-of-accounts",
              "api-reference/ledger-entries",
              "api-reference/allocations",
              "api-reference/dimensions"
            ]
          },
          {
            "group": "Banking",
            "pages": [
              "api-reference/bank-accounts",
              "api-reference/bank-movements",
              "api-reference/bank-connections"
            ]
          },
          {
            "group": "Documents",
            "pages": [
              "api-reference/invoices",
              "api-reference/partners",
              "api-reference/attachments"
            ]
          },
          {
            "group": "Reports & Audit",
            "pages": [
              "api-reference/reports",
              "api-reference/audit-trail"
            ]
          },
          {
            "group": "Sources & Integrations",
            "pages": [
              "api-reference/sources",
              "api-reference/source-feeds",
              "api-reference/integrations",
              "api-reference/sii"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "api-reference/fx-rates",
              "api-reference/reference-data",
              "api-reference/onboarding"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://sintropix.com"
    }
  },
  "background": {
    "color": {
      "light": "#fdfdfd",
      "dark": "#10141c"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "styling": {
    "codeblocks": "system",
    "eyebrows": "section"
  }
}
