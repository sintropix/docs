      "source": "/api-reference/recommendations",
      "destination": "/api-reference/follow-ups"
    },
    {
      "source": "/api-reference/bank-connections",
      "destination": "/api-reference/bank-feeds"
    },
    {
      "source": "/api-reference/todos",
      "destination": "/api-reference/tasks"
    },
    {
      "source": "/api-reference/inbox",
      "destination": "/api-reference/integrations#mailbox"
    }
  ]
